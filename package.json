{
  "name": "devtoolbox",
  "version": "0.1.0",
  "description": "A lightweight, browser-only collection of everyday developer utilities \u2014 format, encode, convert, and inspect common data without leaving the tab.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "stats": "bash scripts/update-contributor-stats.sh"
  },
  "keywords": [
    "developer-tools",
    "utilities",
    "browser",
    "json",
    "base64",
    "typescript"
  ],
  "author": "Danny",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
